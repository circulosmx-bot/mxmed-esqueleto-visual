{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "mx-central-1",
          "aws:RequestTag/Project": "mxmed",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/Phase": "C3"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:DeleteAlias",
        "kms:DescribeKey",
        "kms:EnableKeyRotation",
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:TagResource"
      ],
      "Resource": "arn:aws:kms:mx-central-1:875691018466:key/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "mx-central-1",
          "aws:ResourceTag/Project": "mxmed",
          "aws:ResourceTag/Environment": "staging",
          "aws:ResourceTag/Phase": "C3"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
      "Resource": "arn:aws:kms:mx-central-1:875691018466:key/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "mx-central-1",
          "aws:ResourceTag/Project": "mxmed",
          "aws:ResourceTag/Environment": "staging",
          "aws:ResourceTag/Phase": "C3",
          "kms:ViaService": "secretsmanager.mx-central-1.amazonaws.com"
        },
        "ArnLike": {
          "kms:EncryptionContext:SecretARN": [
            "arn:aws:secretsmanager:mx-central-1:875691018466:secret:/mxmed/staging/application/session-signing-*",
            "arn:aws:secretsmanager:mx-central-1:875691018466:secret:/mxmed/staging/providers/stripe/secret-key-*",
            "arn:aws:secretsmanager:mx-central-1:875691018466:secret:/mxmed/staging/providers/stripe/webhook-secret-*",
            "arn:aws:secretsmanager:mx-central-1:875691018466:secret:/mxmed/staging/providers/ai/api-key-*"
          ]
        }
      }
    },
    {
      "Sid": "ManageExactSecurityAliases",
      "Effect": "Allow",
      "Action": ["kms:CreateAlias", "kms:DeleteAlias", "kms:UpdateAlias"],
      "Resource": [
        "arn:aws:kms:mx-central-1:875691018466:alias/mxmed-stg-application-data",
        "arn:aws:kms:mx-central-1:875691018466:alias/mxmed-stg-secrets",
        "arn:aws:kms:mx-central-1:875691018466:alias/mxmed-stg-audit",
        "arn:aws:kms:mx-central-1:875691018466:alias/mxmed-stg-backup"
      ],
      "Condition": { "StringEquals": { "aws:RequestedRegion": "mx-central-1" } }
    },
    {
      "Effect": "Allow",
      "Action": ["kms:ListAliases", "secretsmanager:GetRandomPassword"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "mx-central-1" } }
    },
    {
      "Sid": "ManageExactSecuritySecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:TagResource"
      ],
      "Resource": [
        "arn:aws:secretsmanager:mx-central-1:875691018466:secret:/mxmed/staging/application/session-signing-*",
        "arn:aws:secretsmanager:mx-central-1:875691018466:secret:/mxmed/staging/providers/stripe/secret-key-*",
        "arn:aws:secretsmanager:mx-central-1:875691018466:secret:/mxmed/staging/providers/stripe/webhook-secret-*",
        "arn:aws:secretsmanager:mx-central-1:875691018466:secret:/mxmed/staging/providers/ai/api-key-*"
      ],
      "Condition": { "StringEquals": { "aws:RequestedRegion": "mx-central-1" } }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucketPolicy",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::mxmed-stg-audit-875691018466-mx-central-1",
        "arn:aws:s3:::mxmed-stg-audit-875691018466-mx-central-1/*"
      ]
    },
    {
      "Sid": "ManageExactManagementTrail",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:AddTags",
        "cloudtrail:CreateTrail",
        "cloudtrail:DeleteTrail",
        "cloudtrail:GetTrailStatus",
        "cloudtrail:StartLogging",
        "cloudtrail:StopLogging",
        "cloudtrail:UpdateTrail"
      ],
      "Resource": "arn:aws:cloudtrail:mx-central-1:875691018466:trail/mxmed-stg-management-trail"
    },
    {
      "Sid": "ManageExactSecurityLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:AssociateKmsKey",
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource"
      ],
      "Resource": "arn:aws:logs:mx-central-1:875691018466:log-group:/mxmed/staging/security/cloudtrail:*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": [
        "arn:aws:iam::875691018466:role/mxmed-stg-cloudtrail-logs-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-ecs-execution-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-application-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-migration-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-jobs-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::875691018466:policy/mxmed-stg-workload-boundary",
          "aws:RequestTag/Project": "mxmed",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/Phase": "C3"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::875691018466:role/mxmed-stg-cloudtrail-logs-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-ecs-execution-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-application-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-migration-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-jobs-role"
      ]
    },
    {
      "Sid": "ManageExactSecurityBoundaries",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::875691018466:policy/mxmed-stg-workload-boundary",
        "arn:aws:iam::875691018466:policy/mxmed-stg-deployment-boundary"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": [
        "arn:aws:iam::875691018466:role/mxmed-stg-cloudtrail-logs-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-ecs-execution-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-application-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-migration-role",
        "arn:aws:iam::875691018466:role/mxmed-stg-jobs-role"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::875691018466:policy/mxmed-stg-workload-boundary",
            "arn:aws:iam::875691018466:policy/mxmed-stg-deployment-boundary"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::875691018466:role/mxmed-stg-cloudtrail-logs-role",
      "Condition": { "StringEquals": { "iam:PassedToService": "cloudtrail.amazonaws.com" } }
    }
  ]
}
