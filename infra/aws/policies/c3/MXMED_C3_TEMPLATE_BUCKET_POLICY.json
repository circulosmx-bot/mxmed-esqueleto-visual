{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTemplateTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::mxmed-stg-c3-cf-templates-875691018466-mx-central-1",
        "arn:aws:s3:::mxmed-stg-c3-cf-templates-875691018466-mx-central-1/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "AllowExactDeployRoleBucketInspection",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::875691018466:role/MXMed-C3-Staging-Deploy"
      },
      "Action": [
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::mxmed-stg-c3-cf-templates-875691018466-mx-central-1"
    },
    {
      "Sid": "AllowExactDeployRoleSealedTemplateObjects",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::875691018466:role/MXMed-C3-Staging-Deploy"
      },
      "Action": ["s3:DeleteObject", "s3:GetObject", "s3:GetObjectAttributes", "s3:PutObject"],
      "Resource": "arn:aws:s3:::mxmed-stg-c3-cf-templates-875691018466-mx-central-1/c3-*/*/*.template.json"
    }
  ]
}
