{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyRegionalNetworkState",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "logs:DescribeLogGroups"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "mx-central-1" } }
    },
    {
      "Sid": "CreateOnlyTaggedC3NetworkResources",
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateAddress",
        "ec2:CreateFlowLogs",
        "ec2:CreateInternetGateway",
        "ec2:CreateNatGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateSubnet",
        "ec2:CreateVpc",
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": [
        "arn:aws:ec2:mx-central-1:875691018466:elastic-ip/*",
        "arn:aws:ec2:mx-central-1:875691018466:flow-log/*",
        "arn:aws:ec2:mx-central-1:875691018466:internet-gateway/*",
        "arn:aws:ec2:mx-central-1:875691018466:natgateway/*",
        "arn:aws:ec2:mx-central-1:875691018466:route-table/*",
        "arn:aws:ec2:mx-central-1:875691018466:security-group/*",
        "arn:aws:ec2:mx-central-1:875691018466:subnet/*",
        "arn:aws:ec2:mx-central-1:875691018466:vpc/*",
        "arn:aws:ec2:mx-central-1:875691018466:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "mx-central-1",
          "aws:RequestTag/Project": "mxmed",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/Phase": "C3"
        }
      }
    },
    {
      "Sid": "MutateOnlyTaggedC3NetworkResources",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateRoute",
        "ec2:CreateTags",
        "ec2:DeleteFlowLogs",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteNatGateway",
        "ec2:DeleteRoute",
        "ec2:DeleteRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteSubnet",
        "ec2:DeleteVpc",
        "ec2:DeleteVpcEndpoints",
        "ec2:DetachInternetGateway",
        "ec2:DisassociateRouteTable",
        "ec2:ModifySubnetAttribute",
        "ec2:ModifyVpcAttribute",
        "ec2:ReleaseAddress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:ec2:mx-central-1:875691018466:elastic-ip/*",
        "arn:aws:ec2:mx-central-1:875691018466:flow-log/*",
        "arn:aws:ec2:mx-central-1:875691018466:internet-gateway/*",
        "arn:aws:ec2:mx-central-1:875691018466:natgateway/*",
        "arn:aws:ec2:mx-central-1:875691018466:route-table/*",
        "arn:aws:ec2:mx-central-1:875691018466:security-group/*",
        "arn:aws:ec2:mx-central-1:875691018466:subnet/*",
        "arn:aws:ec2:mx-central-1:875691018466:vpc/*",
        "arn:aws:ec2:mx-central-1:875691018466:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "mx-central-1",
          "aws:ResourceTag/Project": "mxmed",
          "aws:ResourceTag/Environment": "staging",
          "aws:ResourceTag/Phase": "C3"
        }
      }
    },
    {
      "Sid": "ManageExactNetworkLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource"
      ],
      "Resource": "arn:aws:logs:mx-central-1:875691018466:log-group:mxmed-stg-network-flow-logs:*"
    },
    {
      "Sid": "CreateExactFlowLogsRoleWithBoundary",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::875691018466:role/mxmed-stg-vpc-flow-logs-role",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::875691018466:policy/MXMed-C3-CFN-Network-Boundary",
          "aws:RequestTag/Project": "mxmed",
          "aws:RequestTag/Environment": "staging",
          "aws:RequestTag/Phase": "C3"
        }
      }
    },
    {
      "Sid": "ManageExactFlowLogsRole",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::875691018466:role/mxmed-stg-vpc-flow-logs-role"
    },
    {
      "Sid": "PassExactFlowLogsRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::875691018466:role/mxmed-stg-vpc-flow-logs-role",
      "Condition": { "StringEquals": { "iam:PassedToService": "vpc-flow-logs.amazonaws.com" } }
    }
  ]
}
