{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateNetworkChangeSetWithExactRole",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-network/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Network"
        }
      }
    },
    {
      "Sid": "CreateSecurityChangeSetWithExactRole",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-security/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Security"
        }
      }
    },
    {
      "Sid": "CreateSessionChangeSetWithExactRole",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-session/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Session"
        }
      }
    },
    {
      "Sid": "CreateRegistryChangeSetWithExactRole",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-registry/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Registry"
        }
      }
    },
    {
      "Sid": "CreateRunnerChangeSetWithExactRole",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-c3-runner/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Runner"
        }
      }
    },
    {
      "Sid": "CreateJanitorChangeSetWithExactRole",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-c3-janitor/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Janitor"
        }
      }
    },
    {
      "Sid": "OrchestrateOnlyExactC3Stacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStackResources"
      ],
      "Resource": [
        "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-network/*",
        "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-security/*",
        "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-session/*",
        "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-registry/*",
        "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-c3-runner/*",
        "arn:aws:cloudformation:mx-central-1:875691018466:stack/mxmed-stg-c3-janitor/*"
      ]
    },
    {
      "Sid": "PassOnlyExactCfnExecutionRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Network",
        "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Security",
        "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Session",
        "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Registry",
        "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Runner",
        "arn:aws:iam::875691018466:role/MXMed-C3-CFN-Janitor"
      ],
      "Condition": { "StringEquals": { "iam:PassedToService": "cloudformation.amazonaws.com" } }
    },
    {
      "Sid": "DescribeExactStagingSessionReplicationGroupForEndpointResolution",
      "Effect": "Allow",
      "Action": "elasticache:DescribeReplicationGroups",
      "Resource": "arn:aws:elasticache:mx-central-1:875691018466:replicationgroup:mxmed-stg-session",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "mx-central-1" } }
    },
    {
      "Sid": "CreateAndSecureExactTemporaryTemplateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:ListBucket",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutEncryptionConfiguration"
      ],
      "Resource": "arn:aws:s3:::mxmed-stg-c3-cf-templates-875691018466-mx-central-1"
    },
    {
      "Sid": "TransportOnlySealedC3Templates",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:GetObject", "s3:GetObjectAttributes", "s3:PutObject"],
      "Resource": "arn:aws:s3:::mxmed-stg-c3-cf-templates-875691018466-mx-central-1/c3-*/*/*.template.json"
    },
    {
      "Sid": "PushOnlyC3ApplicationRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:mx-central-1:875691018466:repository/mxmed-stg-application"
    },
    {
      "Sid": "ManageOnlyC3DirectBudget",
      "Effect": "Allow",
      "Action": ["budgets:ModifyBudget", "budgets:ViewBudget"],
      "Resource": "arn:aws:budgets::875691018466:budget/mxmed-stg-c3-*"
    },
    {
      "Sid": "AuthenticateEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "mx-central-1" } }
    }
  ]
}
